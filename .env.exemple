# Choix du LLM: "ollama" (local) ou "groq" (cloud)
LLM_PROVIDER=ollama

# Si Ollama (local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Si Groq (cloud) - https://console.groq.com/keys
GROQ_API_KEY=votre_cle_groq
GROQ_MODEL=llama3-70b-8192

# NewsAPI (gratuit: 100 requetes/jour) - https://newsapi.org/register
NEWSAPI_KEY=votre_cle_newsapi

# FRED API (gratuit) - https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=votre_cle_fred

# Planification
DAILY_BRIEF_HOUR=8
DAILY_BRIEF_MINUTE=0
POLL_INTERVAL_MINUTES=15
